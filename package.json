{
  "name": "openclaw-plugin-model-fetch",
  "version": "0.2.3",
  "description": "OpenClaw plugin tool that refreshes configured provider model lists into OpenClaw config with independent per-provider filters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdoShan/OpenClaw-ModelFetch.git"
  },
  "homepage": "https://github.com/AdoShan/OpenClaw-ModelFetch#readme",
  "bugs": {
    "url": "https://github.com/AdoShan/OpenClaw-ModelFetch/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "model-fetch",
    "openrouter",
    "ollama",
    "models"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README-CN.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "prepublishOnly": "npm run plugin:build",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "openclaw": "latest",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "controlUi": "./src/control-ui.ts",
    "build": {
      "openclawVersion": "2026.10.5"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
