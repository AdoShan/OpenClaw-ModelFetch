{
  "id": "model-fetch",
  "name": "Model Fetch",
  "description": "Fetch and refresh configured provider model lists into OpenClaw config with independent per-provider filters.",
  "version": "0.2.9",
  "configSchema": {
    "type": "object",
    "properties": {
      "providers": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "properties": {
              "filter": {
                "type": "object",
                "properties": {
                  "includeRegex": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "excludeRegex": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "manualIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "maxItems": 1000,
                    "uniqueItems": true
                  },
                  "replace": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "targetAgents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 256,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "uiCapabilities": [
    "page",
    "navigation"
  ],
  "controlUi": {
    "entry": "dist/control-ui/5e7c52c3c0fc8c04a2bffdd2a1cb8ab395800f892ba686381c4918e58bbe6736/index.js",
    "styles": [
      "dist/control-ui/5e7c52c3c0fc8c04a2bffdd2a1cb8ab395800f892ba686381c4918e58bbe6736/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "model_fetch"
    ]
  }
}
